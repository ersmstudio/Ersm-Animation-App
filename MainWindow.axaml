<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Ersm_Animation_App"
        xmlns:controls="using:Ersm_Animation_App.Controls"
        x:Class="Ersm_Animation_App.MainWindow"
        Title="Ersm Animation App V1.0" Width="1280" Height="720"
        Background="{DynamicResource PrimaryBg}"
        Closing="Window_Closing">

    <Grid RowDefinitions="Auto, Auto, *, Auto, 150, Auto" ColumnDefinitions="60, *, Auto">
        
        <!-- Menu Bar -->
        <Menu Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource ToolbarBg}" Foreground="{DynamicResource Text}">
            <MenuItem Header="_File">
                <MenuItem Header="New Project" Click="MenuNewProject_Click"/>
                <MenuItem Header="Open..." Click="MenuOpen_Click"/>
                <MenuItem Header="Save" Click="MenuSave_Click" HotKey="Ctrl+S"/>
                <MenuItem Header="Save As..." Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem Header="Export as MP4..." Click="MenuExportMp4_Click"/>
                <MenuItem Header="Export as GIF..." Click="MenuExportGif_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" Click="MenuUndo_Click" HotKey="Ctrl+Z"/>
                <MenuItem Header="Redo" Click="MenuRedo_Click" HotKey="Ctrl+Shift+Z"/>
                <Separator/>
                <MenuItem Header="Clear Current Frame" Click="MenuClearFrame_Click" HotKey="Delete"/>
            </MenuItem>
            <MenuItem Header="_Animation">
                <MenuItem Header="Play/Pause" Click="MenuPlayPause_Click" HotKey="Space"/>
                <MenuItem Header="Add Frame" Click="MenuAddFrame_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>
        
        <!-- Tool Settings Bar -->
        <controls:ToolSettingsBar x:Name="ToolSettings" Grid.Row="1" Grid.ColumnSpan="3" />
        
        <!-- Left Tool Bar -->
        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource ToolbarBg}" Padding="5">
            <StackPanel Spacing="10">
                <!-- Selectors -->
                <ToggleButton x:Name="BtnSelect" Content="↖️" ToolTip.Tip="Select" Width="40" Height="40" Click="Tool_Click" FontSize="18"/>
                <ToggleButton x:Name="BtnLasso" Content="✂️" ToolTip.Tip="Lasso Select" Width="40" Height="40" Click="Tool_Click" FontSize="18"/>
                <Separator Background="{DynamicResource Border}" Height="1" Margin="0,5"/>
                
                <!-- Drawing -->
                <ToggleButton x:Name="BtnPencil" Content="✏️" ToolTip.Tip="Pencil" Width="40" Height="40" IsChecked="True" Click="Tool_Click" FontSize="18"/>
                <ToggleButton x:Name="BtnBrush" Content="🖌️" ToolTip.Tip="Brush" Width="40" Height="40" Click="Tool_Click" FontSize="18"/>
                <ToggleButton x:Name="BtnBucket" Content="🪣" ToolTip.Tip="Paint Bucket (Fill)" Width="40" Height="40" Click="Tool_Click" FontSize="18"/>
                <ToggleButton x:Name="BtnEraser" Content="🧹" ToolTip.Tip="Eraser" Width="40" Height="40" Click="Tool_Click" FontSize="18"/>
                <Separator Background="{DynamicResource Border}" Height="1" Margin="0,5"/>
                
                <!-- Shapes & Text -->
                <ToggleButton x:Name="BtnLine" Content="📏" ToolTip.Tip="Line" Width="40" Height="40" Click="Tool_Click" FontSize="18"/>
                <ToggleButton x:Name="BtnRect" Content="⬜" ToolTip.Tip="Rectangle" Width="40" Height="40" Click="Tool_Click" FontSize="18"/>
                <ToggleButton x:Name="BtnEllipse" Content="⭕" ToolTip.Tip="Ellipse" Width="40" Height="40" Click="Tool_Click" FontSize="18"/>
                <ToggleButton x:Name="BtnText" Content="T" ToolTip.Tip="Text" Width="40" Height="40" Click="Tool_Click" FontSize="18" FontWeight="Bold"/>
                
                <Separator Background="{DynamicResource Border}" Height="1" Margin="0,5"/>
                
                <!-- Dual Colors (Stroke & Fill) -->
                <Grid Width="40" Height="50" Margin="0,5">
                    <!-- Fill Color (Back) -->
                    <SplitButton x:Name="FillColorBtn" Width="30" Height="30" Padding="0" Margin="10,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="FillColorBtn_Click" ZIndex="0">
                        <Border x:Name="FillColorBorder" Width="30" Height="30" Background="White" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" />
                        <SplitButton.Flyout>
                            <Flyout Placement="Right">
                                <controls:CustomColorPicker x:Name="FillColorPicker" />
                            </Flyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    
                    <!-- Stroke Color (Front) -->
                    <SplitButton x:Name="StrokeColorBtn" Width="30" Height="30" Padding="0" Margin="0,0,10,20" HorizontalAlignment="Left" VerticalAlignment="Top" Click="StrokeColorBtn_Click" ZIndex="1">
                        <Border x:Name="StrokeColorBorder" Width="30" Height="30" Background="Black" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" />
                        <SplitButton.Flyout>
                            <Flyout Placement="Right">
                                <controls:CustomColorPicker x:Name="StrokeColorPicker" />
                            </Flyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    
                    <!-- Swap Button -->
                    <Button Content="↔" Width="20" Height="20" Padding="0" Margin="20,0,0,25" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" Click="SwapColors_Click" ZIndex="2"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Canvas Area with ZoomBorder -->
        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource PrimaryBg}" ClipToBounds="True">
            <controls:ZoomBorder x:Name="ZoomCtrl" Background="Transparent">
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CanvasBg}" Margin="20">
                    <local:DrawingCanvas x:Name="AnimCanvas" />
                </Border>
            </controls:ZoomBorder>
        </Border>

        <!-- Right Panel (GridSplitter + Panel) -->
        <GridSplitter Grid.Row="2" Grid.Column="2" Grid.RowSpan="3" ResizeDirection="Columns" HorizontalAlignment="Left" Width="4"/>
        <controls:RightPanel x:Name="RightPanel" Grid.Row="2" Grid.Column="2" Grid.RowSpan="3" Margin="4,0,0,0" Width="250"/>

        <GridSplitter Grid.Row="3" Grid.Column="1" ResizeDirection="Rows" VerticalAlignment="Top" Height="4"/>

        <!-- Timeline -->
        <controls:TimelinePanel x:Name="Timeline" Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" />

        <!-- Status Bar -->
        <Border Grid.Row="5" Grid.ColumnSpan="3" Background="{DynamicResource StatusBar}" Padding="5">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock x:Name="StatusFrameText" Text="Frame: 1 / 1" />
                <TextBlock x:Name="StatusToolText" Text="Tool: Pencil" />
                <TextBlock x:Name="StatusSavedText" Text="Ready" Foreground="{DynamicResource TextLight}"/>
            </StackPanel>
        </Border>
        
    </Grid>
</Window>
